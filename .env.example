# Required for CrewAI/LiteLLM requests to Groq. Never commit a real key.
GROQ_API_KEY=replace-with-your-groq-api-key

# Optional limits. Defaults: 5 diagnostic starts per user per minute; 4000 characters.
AUTODIAG_REQUESTS_PER_MINUTE=5
AUTODIAG_MAX_INPUT_CHARS=4000
AUTODIAG_DOMAIN=your-domain.example

# Optional destination used by Gmail report delivery.
AUTODIAG_EMAIL=your-address@example.com

# Gmail OAuth files are local-only and must stay in secrets/ (gitignored).
